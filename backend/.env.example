PORT=3000
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_CHAT_ID=your_telegram_chat_id_here
DB_PATH=./data/inavto.db
# Ключ доступа в админку (/admin). Придумайте длинную случайную строку.
ADMIN_TOKEN=
# Папка для загруженных фото (на Railway укажите путь на Volume, например /data/uploads)
UPLOAD_DIR=
# Разрешённые внешние origins через запятую. Оставьте пустым, если сайт и API
# работают на одном домене (same-origin запросы продолжат работать).
CORS_ORIGINS=

# --- Массовый импорт изображений (deploy/update-images.sh) ---
# Медиатека-источник: подпапки <slug>/ с фото или файлы <slug>-1.jpg
# По умолчанию: рядом с базой, /var/lib/inavto/media-in
MEDIA_IN_DIR=
# Лицензированный список URL (CSV: slug;url;url;...) — если появится платный фото-API
IMAGES_URL_CSV=
# Параллельность / лимит фото на машину / ширина / качество WebP
IMAGES_CONCURRENCY=10
IMAGES_MAX_PER_CAR=20
IMAGES_WIDTH=1600
IMAGES_QUALITY=85
